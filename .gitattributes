# Normalize text to LF in the repo; check out native on each OS.
* text=auto eol=lf

# Never let Git touch line endings on binary assets (Windows CRLF munging
# would corrupt fonts / PDFs and make binary diffs churn).
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.ico   binary
